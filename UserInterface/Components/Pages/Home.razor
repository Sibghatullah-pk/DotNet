@page "/"
@using Model
@using BusinessLogic
@inject IProductService ProductService
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<PageTitle>Product Management</PageTitle>

<div class="container mt-4">
    <h3 class="mb-4">Product Management (CRUD)</h3>

    <!-- Status Messages -->
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
        </div>
    }
    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @successMessage
            <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
        </div>
    }

    <!-- Create & Update Form -->
    <div class="card p-3 mb-4 shadow-sm">
        <h5>@(isEditing ? "Edit Product" : "Add New Product")</h5>
        <div class="row g-3 mt-1">
            <div class="col-md-3">
                <input type="number" class="form-control" placeholder="Product ID" @bind="currentProduct.PId" disabled="@isEditing" />
            </div>
            <div class="col-md-4">
                <input type="text" class="form-control" placeholder="Product Name" @bind="currentProduct.ProductName" />
            </div>
            <div class="col-md-3">
                <input type="number" class="form-control" placeholder="Price" @bind="currentProduct.Price" />
            </div>
            <div class="col-md-2">
                @if (isEditing)
                {
                    <button class="btn btn-warning me-1" @onclick="SaveUpdateAsync">Save</button>
                    <button class="btn btn-secondary" @onclick="CancelEdit">Cancel</button>
                }
                else
                {
                    <button class="btn btn-primary w-100" @onclick="CreateProductAsync">Add</button>
                }
            </div>
        </div>
    </div>

    <!-- Read & Delete Table -->
    @if (isLoading && (productList == null || !productList.Any()))
    {
        <p><em>Loading data from database...</em></p>
    }
    else if (productList == null || !productList.Any())
    {
        <p class="text-muted">No products found in database.</p>
    }
    else
    {
        <table class="table table-bordered table-striped align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Product ID</th>
                    <th>Product Name</th>
                    <th>Price</th>
                    <th style="width: 150px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var prod in productList)
                {
                    <tr>
                        <td>@prod.PId</td>
                        <td>@prod.ProductName</td>
                        <td>$@prod.Price</td>
                        <td>
                            <button class="btn btn-sm btn-info me-1" @onclick="() => StartEdit(prod)">Edit</button>
                            <button class="btn btn-sm btn-danger" @onclick="() => DeleteProductAsync(prod.PId)">Delete</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private List<ProductModel> productList = new();
    private ProductModel currentProduct = new();
    private bool isEditing = false;
    private bool isLoading = true;
    private string? errorMessage;
    private string? successMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadProductsAsync();
    }

    private async Task LoadProductsAsync()
    {
        isLoading = true;
        try
        {
            var data = await ProductService.GetAllDataAsync();
            productList = data;
            errorMessage = null;
        }
        catch (Exception)
        {
            errorMessage = "Could not load products. Check the database connection and permissions, then try again.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task CreateProductAsync()
    {
        errorMessage = null;
        successMessage = null;

        if (currentProduct.PId <= 0 || string.IsNullOrWhiteSpace(currentProduct.ProductName))
        {
            errorMessage = "Please enter a valid Product ID and Name.";
            return;
        }

        bool success;
        try
        {
            success = await ProductService.AddProductAsync(currentProduct);
        }
        catch (Exception)
        {
            errorMessage = "Could not add the product because the database is unavailable or denied access.";
            return;
        }
        if (success)
        {
            successMessage = $"Product '{currentProduct.ProductName}' added successfully!";
            currentProduct = new ProductModel();
            await LoadProductsAsync();
        }
        else
        {
            errorMessage = $"Failed to add product. Primary key ID {currentProduct.PId} might already exist.";
        }
    }

    private void StartEdit(ProductModel product)
    {
        errorMessage = null;
        successMessage = null;
        isEditing = true;
        currentProduct = new ProductModel
        {
            PId = product.PId,
            ProductName = product.ProductName,
            Price = product.Price
        };
    }

    private async Task SaveUpdateAsync()
    {
        errorMessage = null;
        successMessage = null;

        bool success;
        try
        {
            success = await ProductService.UpdateProductAsync(currentProduct);
        }
        catch (Exception)
        {
            errorMessage = "Could not update the product because the database is unavailable or denied access.";
            return;
        }

        if (success)
        {
            successMessage = "Product updated successfully!";
            isEditing = false;
            currentProduct = new ProductModel();
            await LoadProductsAsync();
        }
        else
        {
            errorMessage = "Failed to update product.";
        }
    }

    private void CancelEdit()
    {
        isEditing = false;
        currentProduct = new ProductModel();
        errorMessage = null;
        successMessage = null;
    }

    private async Task DeleteProductAsync(int pId)
    {
        errorMessage = null;
        successMessage = null;

        bool success;
        try
        {
            success = await ProductService.DeleteProductAsync(pId);
        }
        catch (Exception)
        {
            errorMessage = "Could not delete the product because the database is unavailable or denied access.";
            return;
        }

        if (success)
        {
            successMessage = $"Product {pId} deleted.";
            await LoadProductsAsync();
        }
        else
        {
            errorMessage = "Failed to delete product.";
        }
    }
}
